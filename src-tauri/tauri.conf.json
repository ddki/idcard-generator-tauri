{
	"$schema": "https://schema.tauri.app/config/1",
	"build": {
		"beforeDevCommand": "pnpm run dev",
		"beforeBuildCommand": "pnpm run build",
		"devPath": "http://localhost:1420",
		"distDir": "../dist",
		"withGlobalTauri": false
	},
	"package": {
		"productName": "idcard-generator",
		"version": "0.1.14"
	},
	"tauri": {
		"allowlist": {
			"all": false,
			"shell": {
				"all": false,
				"open": true
			},
			"dialog": {
				"all": false,
				"open": true
			},
			"process": {
				"all": false,
				"relaunch": true
			}
		},
		"bundle": {
			"active": true,
			"targets": "all",
			"identifier": "idcard-generator.ddki.github.io",
			"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
			"resources": [],
			"externalBin": [],
			"copyright": "ddki",
			"category": "DeveloperTool",
			"shortDescription": "",
			"longDescription": "",
			"macOS": {
				"entitlements": null,
				"exceptionDomain": "",
				"frameworks": [],
				"providerShortName": null,
				"signingIdentity": null
			},
			"windows": {
				"certificateThumbprint": null,
				"digestAlgorithm": "sha256",
				"timestampUrl": "",
				"wix": {
					"template": "./wix/peruser.wxs",
					"license": "../LICENSE",
					"language": ["zh-CN"]
				}
			}
		},
		"security": {
			"csp": null
		},
		"updater": {
			"active": true,
			"dialog": false,
			"endpoints": ["https://github.com/ddki/idcard-generator-tauri/releases/latest/download/latest.json"],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NEExOThEQkE2RUI3RjUKUldUMXQyNjZqUmxLR1hVaFRCaTBtc0dwSWoyWXBDZVd5UVQ3V040VnFZanBFZzMvaXJoT0tjbkoK",
			"windows": {
				"installMode": "passive"
			}
		},
		"systemTray": {
			"iconPath": "icons/32x32.png",
			"iconAsTemplate": true
		},
		"windows": [
			{
				"height": 800,
				"width": 1450,
				"fullscreen": false,
				"decorations": false,
				"resizable": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"url": "splashscreen.html",
				"label": "splashscreen",
				"center": true
			},
			{
				"height": 800,
				"width": 1450,
				"fullscreen": false,
				"resizable": true,
				"title": "身份证生成器",
				"label": "main",
				"visible": false,
				"center": true,
				"focus": true
			}
		]
	}
}
