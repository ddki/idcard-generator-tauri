{
	"$schema": "../node_modules/@tauri-apps/cli/schema.json",
	"productName": "idcard-generator",
	"version": "2.0.0",
	"identifier": "idcard-generator.ddki.github.io",
	"build": {
		"beforeBuildCommand": "pnpm run build",
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"category": "DeveloperTool",
		"shortDescription": "",
		"longDescription": "",
		"copyright": "ddki",
		"externalBin": [],
		"license": "GPL-3.0",
		"licenseFile": "../LICENSE",
		"resources": [],
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"entitlements": null,
			"exceptionDomain": "",
			"frameworks": [],
			"providerShortName": null,
			"signingIdentity": null
		},
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": "",
			"wix": {
				"template": "./wix/peruser.wxs",
				"language": ["zh-CN"]
			}
		}
	},
	"app": {
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'",
			"devCsp": "default-src 'self' http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
		},
		"windows": [
			{
				"height": 800,
				"width": 1450,
				"fullscreen": false,
				"decorations": false,
				"resizable": false,
				"closable": false,
				"minimizable": false,
				"maximizable": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"url": "splashscreen.html",
				"label": "splashscreen",
				"center": true
			},
			{
				"height": 800,
				"width": 1450,
				"fullscreen": false,
				"resizable": true,
				"title": "身份证生成器",
				"label": "main",
				"visible": false,
				"center": true,
				"focus": true,
				"shadow": true
			}
		]
	},
	"plugins": {
		"updater": {
			"endpoints": ["https://github.com/ddki/idcard-generator-tauri/releases/latest/download/latest.json"],
			"active": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NEExOThEQkE2RUI3RjUKUldUMXQyNjZqUmxLR1hVaFRCaTBtc0dwSWoyWXBDZVd5UVQ3V040VnFZanBFZzMvaXJoT0tjbkoK",
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
