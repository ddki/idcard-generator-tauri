{
	"name": "idcard-generator",
	"version": "2.0.1",
	"author": "ddki",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check build-only",
		"preview": "vite preview",
		"test:unit": "vitest",
		"build-only": "vite build",
		"type-check": "vue-tsc --noEmit --composite false",
		"lint": "eslint . --fix",
		"format": "prettier --write .",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"prepare": "husky",
		"clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
		"clean:lib": "rimraf node_modules",
		"reinstall": "rimraf pnpm-lock.yaml && rimraf package.lock.json && rimraf node_modules && pnpm install",
		"commit": "git-cz",
		"release": "npx release-it --increment patch --config .release-it.cjs",
		"script:changelog": "npx esno scripts/changelog.ts --version ",
		"script:update": "npx esno scripts/update.ts"
	},
	"dependencies": {
		"@tauri-apps/plugin-autostart": "^2.7.0",
		"@tauri-apps/plugin-dialog": "^2.8.4",
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-shell": "^2.6.0",
		"@tauri-apps/plugin-store": "2.5.0",
		"@tauri-apps/plugin-updater": "2.14.1",
		"element-plus": "^2.14.8",
		"pinyin-pro": "^3.29.5",
		"vue": "^3.5.45",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@actions/github": "^9.1.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/types": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@release-it/bumper": "^8.0.1",
		"@release-it/conventional-changelog": "^12.0.2",
		"@tailwindcss/postcss": "^4.3.5",
		"@tauri-apps/api": "2.12.4",
		"@tauri-apps/cli": "2.12.4",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.9.0",
		"commitizen": "^4.3.2",
		"cz-git": "^1.14.0",
		"eslint": "^10.14.0",
		"eslint-plugin-vue": "^10.12.0",
		"esno": "^4.8.0",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"jsdom": "^31.0.0",
		"kleur": "^4.1.5",
		"less": "^4.9.1",
		"minimist": "^1.2.8",
		"node-fetch": "^3.3.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"release-it": "^21.1.2",
		"rimraf": "^6.1.4",
		"sass-embedded": "^1.108.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"unplugin-auto-import": "^21.1.0",
		"unplugin-element-plus": "^0.11.2",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	},
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx,md,json,css,scss,yaml}": [
			"prettier --write"
		],
		"**/*.{cjs,mjs,ts,vue}": [
			"eslint --fix"
		],
		"**/*": [
			"git add"
		]
	}
}
